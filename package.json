{
    "name": "isaac-lua-api-vscode",
    "publisher": "Filloax",
    "displayName": "Binding of Isaac Lua API",
    "description": "Adds support and autocomplete for the The Binding of Isaac: Repentance modding API",
    "version": "1.17.0",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/filloax/isaac-lua-api-vscode"
    },
    "bugs": {
        "url": "https://github.com/filloax/isaac-lua-api-vscode/issues"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.68.0"
    },
    "categories": [
        "Linters"
    ],
    "keywords": [
        "lua",
        "isaac",
        "repentance",
        "modding",
        "mod"
    ],
    "activationEvents": [
        "workspaceContains:**/metadata.xml",
        "onLanguage:lua"
    ],
    "main": "./out/extension.js",
    "extensionDependencies": [
        "sumneko.lua"
    ],
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --minify && npm run buildoutput",
        "copyoutput": "node scripts/copyoutput.js",
        "buildoutput": "python scripts/builddocfile.py && npm run copyoutput",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap && npm run buildoutput",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "contributes": {
        "configuration": {
            "title": "The Binding of Isaac Lua API",
            "properties": {
                "boi-lua.workspaceSettings": {
                    "type": "boolean",
                    "default": true,
                    "description": "Add some useful settings to the workspace settings.json (anm2 to XML association)."
                },
                "boi-lua.repentogonEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Repentogon API support"
                },
                "boi-lua.pluginEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable plugin to customize Lua LS behavior. Current effects:\n- :AddCallback autorecognized arg types for functions passed inline to it\n- Functions defined elsewhere in same file but passed to AddCallback will have their args autorecognized"
                },
                "boi-lua.stageAPISupportEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable StageAPI callback autocompletion."
                },
                "boi-lua.callbackFunctionCompletionEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable inline code suggestions for functions which are passed when registering a callback."
                },
                "boi-lua.callbackFunctionCompletionTypes": {
                    "type": "object",
                    "default": {
                        "inlineFunction": true,
                        "localFunction": true,
                        "tableMethod": true
                    },
                    "description": "Choose which types of callback function suggestions to show.",
                    "properties": {
                        "inlineFunction": {
                            "type": "boolean",
                            "default": true,
                            "description": "Inline function: function(...) end"
                        },
                        "localFunction": {
                            "type": "boolean",
                            "default": true,
                            "description": "Local function defined above call: local function onUpdate(...) end"
                        },
                        "tableMethod": {
                            "type": "boolean",
                            "default": true,
                            "description": "Function in one of tables used in the file: function mod:onUpdate(...) end"
                        }
                    },
                    "additionalProperties": false
                },
                "boi-lua.callbackParamAliases": {
                    "type": "object",
                    "default": {},
                    "description": "Define aliases for params suggested by the callback function autocomplete.\nKey represents the string to replace, while Value represents what to replace it with. \n(eg. entity -> e)",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "commands": [
            {
                "command": "boi-lua.activate",
                "title": "Manually activate Isaac Lua autocompletion for this workspace"
            },
            {
                "command": "boi-lua.deactivate",
                "title": "Manually deactivate Isaac Lua autocompletion for this workspace"
            }
        ]
    },
    "devDependencies": {
        "@types/glob": "^7.2.0",
        "@types/luaparse": "^0.2.13",
        "@types/mocha": "^9.1.1",
        "@types/node": "14.x",
        "@types/vscode": "~1.68.0",
        "@typescript-eslint/eslint-plugin": "^5.21.0",
        "@typescript-eslint/parser": "^5.21.0",
        "@vscode/test-electron": "^2.1.3",
        "esbuild": "^0.14.39",
        "eslint": "^8.14.0",
        "glob": "^8.0.1",
        "mocha": "^9.2.2",
        "typescript": "^4.6.4"
    },
    "dependencies": {
        "golden-fleece": "^1.0.9",
        "isaac-lua-api-vscode": "file:",
        "luaparse": "^0.3.1"
    }
}
